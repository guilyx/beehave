# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json,cff,xml,html,css,js,svg,mmd,dot}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Exact bytes matter here: third-party trees and syrupy snapshots.
[tests/fixtures/public/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset

[**/__snapshots__/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
