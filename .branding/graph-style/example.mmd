---
title: "FIG. 1  SURVEY MISSION: FLY OUT, CAPTURE, RETURN, LAND"
config:
  theme: base
  look: classic
  flowchart:
    curve: basis
    nodeSpacing: 40
    rankSpacing: 44
    padding: 14
  themeVariables:
    fontFamily: "Martian Mono, Menlo, Consolas, monospace"
    fontSize: 13px
    background: "#f5f0e9"
    primaryColor: "#fdfbf9"
    primaryTextColor: "#1b1813"
    primaryBorderColor: "#1b1813"
    lineColor: "#1b1813"
    textColor: "#4b4740"
    titleColor: "#4b4740"
    edgeLabelBackground: "#f5f0e9"
    clusterBkg: "#f5f0e9"
    clusterBorder: "#857f77"
  themeCSS: >
    .nodeLabel { font-family: Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 600; font-size: 14px; }
    .nodeLabel .note { font-family: 'Martian Mono', Menlo, Consolas, monospace; font-weight: 400; font-size: 12px; color: #67635a; }
    .cluster-label .nodeLabel { font-family: 'Martian Mono', Menlo, Consolas, monospace; font-weight: 400; font-size: 12px; color: #4b4740; }
    .edgeLabel p { color: #4b4740; }
    .flowchartTitleText { font-size: 12px; fill: #4b4740; }
---
flowchart TB
  %% Beehave graph style, light theme. Hex values come from .branding/tokens/tokens.json.
  %% Graph: examples/aerial/drone_mission.xml.
  %% Labels are measured in Martian Mono (the widest face) so the Archivo node
  %% labels can only gain padding, never clip.

  classDef start   fill:#1b1813,stroke:#1b1813,stroke-width:1.5px,color:#f5f0e9
  classDef action  fill:#fdfbf9,stroke:#1b1813,stroke-width:1.5px,color:#1b1813
  classDef cond    fill:#ece6dd,stroke:#1b1813,stroke-width:1.5px,color:#1b1813
  classDef approx  fill:#fcc50e,stroke:#1b1813,stroke-width:1.5px,stroke-dasharray:4 3,color:#1b1813
  classDef success fill:#107550,stroke:#fdfbf9,stroke-width:2px,color:#fdfbf9
  classDef failure fill:#b93917,stroke:#fdfbf9,stroke-width:2px,color:#fdfbf9

  START((START)):::start
  LandNow[LandNow]:::action

  subgraph mission [" "]
    direction TB
    Arm[Arm]:::action
    TakeOff[TakeOff]:::action
    FlyToWaypoint["FlyToWaypoint<br/><span class='note'>retry ×3</span>"]:::action
    CaptureImage[CaptureImage]:::action
    FlyHome[FlyHome]:::action
    FindLandingSpot[FindLandingSpot]:::action
    FlyToLandingSpot[FlyToLandingSpot]:::action
    Land[Land]:::action
    Disarm[Disarm]:::action
  end

  SUCCESS(((SUCCESS))):::success
  FAILURE(((FAILURE))):::failure

  %% Edges. linkStyle indexes follow this order.
  START -->|"[IsBatteryCritical]"| LandNow
  START -->|"[not IsBatteryCritical]"| Arm
  LandNow --> SUCCESS
  LandNow -.->|fail| Arm
  Arm --> TakeOff
  Arm -.-> FAILURE
  TakeOff -->|"[IsBatteryOK]"| FlyToWaypoint
  TakeOff -->|"[not IsBatteryOK]"| FlyHome
  TakeOff -.-> FAILURE
  FlyToWaypoint --> CaptureImage
  FlyToWaypoint -.->|fail| FlyHome
  CaptureImage --> FlyHome
  FlyHome --> Land
  FlyHome -.->|fail| FindLandingSpot
  FindLandingSpot --> FlyToLandingSpot
  FindLandingSpot -.-> FAILURE
  FlyToLandingSpot --> Land
  FlyToLandingSpot -.-> FAILURE
  Land --> Disarm
  Land -.-> FAILURE
  Disarm --> SUCCESS
  Disarm -.-> FAILURE
  mission -...->|"any#160;step#160;#183;#160;[IsBatteryCritical]"| LandNow

  %% then: ink, solid (START's guarded exits; CaptureImage goes home either way).
  %% success: leaf, solid. failure: cinnabar, dashed 7 4 (no "fail" label into FAILURE).
  %% preemption: prussian, 2.5px, dotted 2 4, drawn from the frame of steps it can interrupt.
  %% Mermaid centres frame titles where this label lands, so "any step" lives in the label.
  %% #160; is a no-break space and #183; a middle dot.
  linkStyle 0,1,11 stroke:#1b1813,stroke-width:1.75px
  linkStyle 2,4,6,7,9,12,14,16,18,20 stroke:#107550,stroke-width:1.75px
  linkStyle 3,5,8,10,13,15,17,19,21 stroke:#b93917,stroke-width:1.75px,stroke-dasharray:7 4
  linkStyle 22 stroke:#063e7d,stroke-width:2.5px,stroke-dasharray:2 4
